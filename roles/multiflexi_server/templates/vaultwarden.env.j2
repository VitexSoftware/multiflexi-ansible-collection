# vaultwarden server environment configuration
# Managed by Ansible – do not edit manually.

DATA_FOLDER={{ multiflexi_vaultwarden_server_data_dir }}
ROCKET_PORT={{ multiflexi_vaultwarden_server_port }}

{% if multiflexi_vaultwarden_server_domain | length > 0 %}
DOMAIN={{ multiflexi_vaultwarden_server_domain }}
{% endif %}

{% if multiflexi_vaultwarden_server_admin_token | length > 0 %}
ADMIN_TOKEN={{ multiflexi_vaultwarden_server_admin_token }}
{% else %}
# ADMIN_TOKEN is not set — the /admin panel is disabled.
# Set multiflexi_vaultwarden_server_admin_token to enable it.
{% endif %}

SIGNUPS_ALLOWED={{ multiflexi_vaultwarden_server_signups_allowed | bool | lower }}

LOG_LEVEL={{ multiflexi_vaultwarden_server_log_level }}

{% if multiflexi_vaultwarden_install_web | bool %}
WEB_VAULT_ENABLED=true
WEB_VAULT_FOLDER={{ multiflexi_vaultwarden_server_web_vault_dir }}
{% else %}
WEB_VAULT_ENABLED=false
{% endif %}
